{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Installer",
  "version": "0.1.0",
  "identifier": "io.github.blueyzx64.Installer",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Installer",
        "width": 600,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Install apps by dragging them to Applications",
    "longDescription": "Open an app package, drag it to Applications, done. Works with RPM packages and AppImage files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "rpm"
        ],
        "mimeType": "application/x-rpm",
        "name": "App package"
      },
      {
        "ext": [
          "AppImage",
          "appimage"
        ],
        "mimeType": "application/vnd.appimage",
        "name": "App"
      }
    ],
    "linux": {
      "rpm": {
        "depends": [
          "PackageKit",
          "webkit2gtk4.1"
        ],
        "desktopTemplate": "linux/installer.desktop",
        "files": {
          "/usr/share/metainfo/io.github.blueyzx64.Installer.metainfo.xml": "linux/io.github.blueyzx64.Installer.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/io.github.blueyzx64.Installer.metainfo.xml": "linux/io.github.blueyzx64.Installer.metainfo.xml"
        }
      }
    }
  }
}
